# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Guild (server) ID to audit. Numeric, no quotes.
# If unset, /audit works in any guild the bot is in (slash commands still need to be synced).
GUILD_ID=

# Optional: path to a config file for per-guild toggles and whitelist.
# See README for the format. Leave empty to use built-in defaults.
CONFIG_FILE=
